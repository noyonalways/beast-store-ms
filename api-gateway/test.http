### ==========================================
###  Beast Store Microservices — API Gateway Tests
###  Gateway: API Gateway (port 4000)
###  Proxies to: Product (4001), Inventory (4002), Auth (4003)
###
###  NOTE: The gateway exposes every route under the /api prefix and forwards
###  requests to the upstream services. Start the upstream services first,
###  then run these against the gateway.
### ==========================================

### Variables
@baseUrl = http://localhost:4000
@productId  = cmtsuhmwz000270pmk7j2d5eq
@inventoryId = cmtsuhmxz0004pgpm70e15rzm
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbXVlOXM5bXQwMDAwY3NwbW5vMTVuMHNkIiwiZW1haWwiOiJ1c2VyMUBleGFtcGxlLmNvbSIsIm5hbWUiOiJVc2VyIDEiLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc5MjQxMzI0MSwiZXhwIjoxNzkyNDE0MTQxfQ.88GApIO66z-fu-9HKV7DSXzANwuL7xMmjuEpKn_tSJc


# @productId / @inventoryId — NOT declared statically. They are captured at
# runtime from the corresponding "Create" response (requests #3 and #5) via
# client.global.set(), so the id-based requests (#4, #6–#9) use real ids.
# Run requests #3 and #5 first to populate them.

### --------------------------------------------------
### 1. Health Check
### --------------------------------------------------
GET {{baseUrl}}/health
Accept: application/json

### --------------------------------------------------
### 2. Undefined gateway route (should be 404)
### --------------------------------------------------
GET {{baseUrl}}/nonexistent
Accept: application/json

### ==========================================
###  AUTH routes  → proxied to http://localhost:4003
### ==========================================

### --------------------------------------------------
### Auth Register
### --------------------------------------------------
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "pass123"
}

### --------------------------------------------------
### Auth Login
### --------------------------------------------------
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "pass123"
}

### --------------------------------------------------
### Auth Logout
### --------------------------------------------------
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "accessToken": "{{accessToken}}"
}

### --------------------------------------------------
### Auth Get Current User Profile
### --------------------------------------------------
GET {{baseUrl}}/api/auth/whoami
Accept: application/json
Authorization: Bearer {{accessToken}}

### --------------------------------------------------
### Auth Verify Email
### --------------------------------------------------
POST {{baseUrl}}/api/auth/verify-email
Content-Type: application/json

{
  "email": "user1@example.com"
}

### --------------------------------------------------
### Auth Request Password Reset
### --------------------------------------------------
POST {{baseUrl}}/api/auth/request-reset
Content-Type: application/json

{
  "email": "user1@example.com"
}

### --------------------------------------------------
### Auth Reset Password
### --------------------------------------------------
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "user1@example.com",
  "resetToken": "replace-with-reset-token",
  "newPassword": "newPass456"
}

### --------------------------------------------------
### Verify access token — valid token (should be 200)
### --------------------------------------------------
POST {{baseUrl}}/api/auth/verify-access-token
Content-Type: application/json

{
  "accessToken": "{{accessToken}}"
}

### --------------------------------------------------
### Auth Refresh Token
### --------------------------------------------------
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "replace-with-refresh-token"
}

### --------------------------------------------------
### Auth Change Password
### --------------------------------------------------
POST {{baseUrl}}/api/auth/change-password
Content-Type: application/json

{
  "currentPassword": "pass123",
  "newPassword": "newPass456"
}

### ==========================================
###  PRODUCT routes  → proxied to http://localhost:4001
### ==========================================

### --------------------------------------------------
### Create Product — valid payload (minimal)
### --------------------------------------------------
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "sku": "SKU-GATEWAY-002",
  "name": "Beast T-Shirt (via Gateway)"
}

### --------------------------------------------------
### Get Product by id — returns details
### --------------------------------------------------
GET {{baseUrl}}/api/products/{{productId}}
Accept: application/json

### --------------------------------------------------
### List all Products
### --------------------------------------------------
GET {{baseUrl}}/api/products
Accept: application/json

### --------------------------------------------------
### Update Product by id
### --------------------------------------------------
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Updated Beast T-Shirt",
  "sku": "SKU-GATEWAY-001-UPDATED"
}

### --------------------------------------------------
### Delete Product by id
### --------------------------------------------------
DELETE {{baseUrl}}/api/products/{{productId}}
Accept: application/json
Authorization: Bearer {{accessToken}}

### ==========================================
###  INVENTORY routes  → proxied to http://localhost:4002
### ==========================================

### --------------------------------------------------
### Create Inventory
### --------------------------------------------------
POST {{baseUrl}}/api/inventories
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "productId": "{{productId}}",
  "quantity": 100
}

### --------------------------------------------------
### Get Inventory by id
### --------------------------------------------------
GET {{baseUrl}}/api/inventories/{{inventoryId}}
Accept: application/json
Authorization: Bearer {{accessToken}}

### --------------------------------------------------
### Update Inventory — "IN" (add)
### --------------------------------------------------
PUT {{baseUrl}}/api/inventories/{{inventoryId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "actionType": "IN",
  "quantity": 5
}

### --------------------------------------------------
### Update Inventory — "OUT" (subtract)
### --------------------------------------------------
PUT {{baseUrl}}/api/inventories/{{inventoryId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "actionType": "OUT",
  "quantity": 5
}

### --------------------------------------------------
### Get Inventory details — returns history list
### --------------------------------------------------
GET {{baseUrl}}/api/inventories/{{inventoryId}}/details
Accept: application/json
Authorization: Bearer {{accessToken}}

### --------------------------------------------------
### Delete Inventory by id
### --------------------------------------------------
DELETE {{baseUrl}}/api/inventories/{{inventoryId}}
Accept: application/json
Authorization: Bearer {{accessToken}}