{
  "services": {
    "product": {
      "url": "http://localhost:4001",
      "routes": [
        {
          "path": "/products",
          "methods": [
            "GET"
          ],
          "middlewares": []
        },
        {
          "path": "/products",
          "methods": [
            "POST"
          ],
          "middlewares": ["auth"]
        },
        {
          "path": "/products/:id",
          "methods": [
            "GET"
          ],
          "middlewares": []
        }
      ]
    },
    "inventory": {
      "url": "http://localhost:4002",
      "routes": [
        {
          "path": "/inventories/:id",
          "methods": [
            "PUT"
          ],
          "middlewares": ["auth"]
        },
        {
          "path": "/inventories/:id/details",
          "methods": [
            "GET"
          ],
          "middlewares": ["auth"]
        }
      ]
    },
    "auth": {
      "url": "http://localhost:4003",
      "routes": [
        {
          "path": "/auth/login",
          "methods": [
            "POST"
          ],
          "middlewares": []
        },
        {
          "path": "/auth/register",
          "methods": [
            "POST"
            ],
            "middlewares": []
        },
        {
          "path": "/auth/verify-access-token",
          "methods": [
            "POST"
          ],
          "middlewares": []
        },
        {
          "path": "/auth/verify-email",
          "methods": [
            "POST"
          ],
          "middlewares": []
        }
      ]
    },
    "user": {
      "url": "http://localhost:4004",
      "routes": [
        {
          "path": "/users/:id",
          "methods": [
            "GET"
          ],
          "middlewares": ["auth"]
        }
      ]
    }
  }
}