### ==========================================
###  Beast Store Microservices — API Tests
###  Service: Inventory  (port 4002)
### ==========================================

### Variables
@baseUrl = http://localhost:4002

### --------------------------------------------------
### 1. Health Check
### --------------------------------------------------
GET {{baseUrl}}/health
Accept: application/json

> {%
    client.test("Health check returns 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Health status is UP", function () {
        const body = response.body;
        client.assert(body.status === "UP", "Expected status UP, got " + body.status);
    });
%}

### --------------------------------------------------
### 2. Create Inventory — valid payload
### --------------------------------------------------
POST {{baseUrl}}/inventories
Content-Type: application/json

{
  "productId": "prod_001",
  "sku": "SKU-BEAST-001"
}

