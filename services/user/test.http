### ==========================================
###  Beast Store Microservices — API Tests
###  Service: User  (port 4004)
### ==========================================

### Variables
@baseUrl = http://localhost:4004

# @userId — NOT declared statically. It is resolved at runtime from the
# "Create User" response (request #2) via the request-variable reference
# {{createUser.response.body.$.id}}, so requests #7–#10 below use a real id.
# Run request #2 first to populate it.
@userId = cmue9s9mt0000cspmno15n0sd

### --------------------------------------------------
### 1. Health Check
### --------------------------------------------------
GET {{baseUrl}}/health
Accept: application/json


### --------------------------------------------------
### 2. Create User — valid payload (minimal)
###   Stores the returned id as {{userId}} for later requests
### --------------------------------------------------
# @name createUser
POST {{baseUrl}}/users
Content-Type: application/json

{
  "authUserId": "auth-user-001",
  "email": "tester@beast-store.dev",
  "name": "Beast Tester"
}

### --------------------------------------------------
### 3. Create User — full valid payload (address / phone)
### --------------------------------------------------
POST {{baseUrl}}/users
Content-Type: application/json

{
  "authUserId": "auth-user-002",
  "email": "tester2@beast-store.dev",
  "name": "Beast Shopper",
  "address": "123 Beast Street",
  "phone": "+8801700000000"
}

### --------------------------------------------------
### 4. Create User — missing required fields (should be 400)
### --------------------------------------------------
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "missing@beast-store.dev"
}

### --------------------------------------------------
### 5. Create User — invalid email format (should be 400)
### --------------------------------------------------
POST {{baseUrl}}/users
Content-Type: application/json

{
  "authUserId": "auth-user-003",
  "email": "not-an-email",
  "name": "Bad Email"
}

### --------------------------------------------------
### 6. Create User — duplicate authUserId (should be 400)
### --------------------------------------------------
POST {{baseUrl}}/users
Content-Type: application/json

{
  "authUserId": "auth-user-001",
  "email": "duplicate@beast-store.dev",
  "name": "Duplicate User"
}

### ==========================================
###  User detail routes.
###  Run request #2 first so {{userId}} is set.
### ==========================================

### --------------------------------------------------
### 7. Get User by id — internal id (should be 200)
### --------------------------------------------------
GET {{baseUrl}}/users/{{userId}}
Accept: application/json

### --------------------------------------------------
### 8. Get User by authUserId (should be 200)
### --------------------------------------------------
GET {{baseUrl}}/users/{{userId}}?filed=authUserId
Accept: application/json

### --------------------------------------------------
### 9. Get User by id — unknown id (should be 404)
### --------------------------------------------------
GET {{baseUrl}}/users/does-not-exist
Accept: application/json

### --------------------------------------------------
### 10. Get User by id — invalid field value (should be 400)
### --------------------------------------------------
GET {{baseUrl}}/users/{{userId}}?filed=email
Accept: application/json

### --------------------------------------------------
### 11. Undefined route (should be 404)
### --------------------------------------------------
GET {{baseUrl}}/nonexistent
Accept: application/json